# ---------- Core ----------
PORT=3000
# Public URL of the site (used for OAuth redirect URIs and email links)
APP_URL=http://localhost:3000
# Long random string; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me
# Set to "production" when deployed (enables secure cookies, disables dev logins)
NODE_ENV=development
# Allow simulated "developer" logins when real provider keys are missing (never in production)
DEV_LOGIN=true
# How long a session stays signed in after the OTP is entered (days)
SESSION_DAYS=7
APP_NAME=Infiniq

# ---------- Google sign-in (https://console.cloud.google.com/apis/credentials) ----------
# Authorized redirect URI: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Facebook login (https://developers.facebook.com/apps) ----------
# Valid OAuth redirect URI: ${APP_URL}/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---------- WhatsApp (Meta WhatsApp Cloud API) ----------
# Used to send the 6-digit code to a phone number. Needs an approved
# "authentication" message template whose body has one {{1}} variable for the code.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=otp_code
WHATSAPP_TEMPLATE_LANG=en_US

# ---------- Email (any SMTP provider: Gmail Workspace, SendGrid, Mailgun, SES...) ----------
# If SMTP_HOST is empty, emails are written to the dev outbox at /dev/outbox instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Infiniq <no-reply@example.com>"

# ---------- Transcription with speaker separation (pick one) ----------
# assemblyai | deepgram | (empty = browser live transcription only)
TRANSCRIPTION_PROVIDER=
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=

# ---------- AI notes (Claude) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---------- Live Translation add-on (paid feature) ----------
# Translation engine: claude (needs ANTHROPIC_API_KEY) | mock (demo text, for testing only)
TRANSLATION_PROVIDER=
# Model used for translation (defaults to CLAUDE_MODEL). A faster model gives snappier live captions.
CLAUDE_TRANSLATE_MODEL=
# Price shown to users for the add-on
TRANSLATION_PRICE_LABEL=US$4.99 / month
# Test mode: users can activate paid add-ons for free (default on outside production). Turn off when real billing exists.
BILLING_TEST_MODE=true
